# UrbanTwin AI — Production Environment Configuration Example
# Copy this file to .env and configure appropriate values for your deployment environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.

# Application Environment
FLASK_ENV=production
DEBUG=False
PORT=5000
HOST=0.0.0.0

# Security & Session Authentication
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_character_hex_random_key_in_production
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=604800 # 7 Days

# Database Configuration (SQLite by default, PostgreSQL/PostGIS ready)
DB_FILE=climate_twin.db
# DATABASE_URL=postgresql://urbantwin_user:strong_password@localhost:5432/climate_twin

# Live Climate Provider Settings
OPEN_METEO_API_ENABLED=True
OPEN_METEO_TIMEOUT_SECONDS=2.5

# IMD & NASA Earthdata Integration Credentials (Optional for extended high-res thermal grids)
NASA_EARTHDATA_APP_KEY=
IMD_API_TOKEN=

# Audit & Compliance
AUDIT_LOG_ENABLED=True
RATE_LIMIT_LOGIN_MAX=15
RATE_LIMIT_WINDOW_SECONDS=60
